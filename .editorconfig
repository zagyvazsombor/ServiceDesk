root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# AGENTS.md §13: file-scoped namespace
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# AGENTS.md §13: no unused using; usings outside the namespace, System first
dotnet_diagnostic.IDE0005.severity = warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_sort_system_directives_first = true

# AGENTS.md §13: sealed by default (internal types that are never inherited)
dotnet_diagnostic.CA1852.severity = warning

# AGENTS.md §13: primary constructor for DI
csharp_style_prefer_primary_constructors = true:suggestion

# EF Core migrations are generated code without an <auto-generated> header (block namespace, unused usings).
[**/Migrations/*.cs]
generated_code = true
