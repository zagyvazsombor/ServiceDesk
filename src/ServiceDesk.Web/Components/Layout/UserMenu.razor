@using System.Security.Claims
@using ServiceDesk.Application.Users.GetCurrentUserProfile
@using ServiceDesk.Web.UseCases

@implements IDisposable

@inject NavigationManager NavigationManager
@inject IUseCaseRunner Runner

<AuthorizeView>
    <Authorized>
        <MudButton Href="Account/Manage" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Person">
            @(_displayName ?? context.User.FindFirstValue(ClaimTypes.Email) ?? context.User.Identity?.Name)
        </MudButton>
        @* The logout endpoint of the template (MapAdditionalIdentityEndpoints) takes an antiforgery-protected POST. *@
        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                Kijelentkezés
            </MudButton>
        </form>
    </Authorized>
</AuthorizeView>

@code {
    private readonly CancellationTokenSource _cts = new();
    private string? currentUrl;
    private string? _displayName;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        // An anonymous visitor has no profile; calling the use case would only log a denied access.
        if (AuthenticationState is null || (await AuthenticationState).User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var result = await Runner.RunAsync(
            (GetCurrentUserProfileHandler handler, CancellationToken ct) => handler.HandleAsync(new GetCurrentUserProfileQuery(), ct),
            _cts.Token);

        // Admin: the name of the agent profile; otherwise the e-mail address. On failure the e-mail claim stays.
        if (result.IsSuccess)
        {
            _displayName = result.Value.Agent?.DisplayName ?? result.Value.Email;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
