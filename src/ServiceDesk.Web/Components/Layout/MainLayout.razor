@using System.Security.Claims

@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudStaticNavDrawerToggle DrawerId="nav-drawer" @bind-Open="_drawerOpen" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
        <MudText Typo="Typo.h5" Class="ml-3">ServiceDesk</MudText>
        <MudSpacer />
        @* An unexpected exception of the user menu stays in the AppBar: the e-mail claim is shown instead. *@
        <ErrorBoundary>
            <ChildContent>
                <UserMenu />
            </ChildContent>
            <ErrorContent Context="exception">
                <AuthorizeView>
                    <MudText Class="mx-2">@(context.User.FindFirstValue(ClaimTypes.Email) ?? context.User.Identity?.Name)</MudText>
                </AuthorizeView>
            </ErrorContent>
        </ErrorBoundary>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4">
        @* AGENTS.md §11: unexpected exceptions end up here with a generic message and a retry button. *@
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    Váratlan hiba történt. Próbáld újra, vagy frissítsd az oldalt.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Recover">
                    Újrapróbálás
                </MudButton>
            </ErrorContent>
        </ErrorBoundary>
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    Váratlan hiba történt.
    <a href="." class="reload">Újratöltés</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private ErrorBoundary? _errorBoundary;

    // A new page (new Body) clears the error state left by the previous one.
    protected override void OnParametersSet() => Recover();

    private void Recover() => _errorBoundary?.Recover();
}
